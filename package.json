{
  "name": "magicfinder",
  "version": "0.1.0",
  "private": true,
  "description": "Finds the cheapest way to buy a list of Magic: The Gathering singles from New Zealand Stores, postage included.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "vite build && tsx --disable-warning=ExperimentalWarning src/server/main.ts",
    "dev": "tsx scripts/dev.ts",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check-stores": "tsx scripts/check-stores.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "highs": "^1.15.4",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
